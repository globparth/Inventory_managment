# ============================================================================
#  Fill this in, then run:   npm run setup
#  That one command creates every table and, if you fill in the admin section
#  below, your first login too. Nothing here is used by the built website
#  except the two VITE_ variables — the rest only run once, on your computer.
# ============================================================================

# --- Used by the website itself (Supabase > Project Settings > API) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: shown on the public page a visitor sees when they scan a product QR
VITE_ORG_NAME=Your Organization Name
VITE_PUBLIC_CONTACT=

# Optional: the address printed inside the QR codes. Leave empty to use whatever
# address the app is running on. Set this to your FINAL domain before you print.
VITE_PUBLIC_BASE_URL=

# --- Used only by "npm run setup" (never deployed, never sent to the browser) ---

# Supabase > Project Settings > Database > Connection string > URI
# (use "Direct connection". Put your real database password in place of
# [YOUR-PASSWORD] — Supabase shows that placeholder literally in the string.
# If your password contains an "@", encode it as %40, or any other special
# character per RFC 3986, since "@" is a delimiter in this URL format.)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Optional — fill these in and "npm run setup" creates your first admin login
# automatically. Leave blank to create it by hand in the Supabase dashboard instead.
# Get SUPABASE_SERVICE_ROLE_KEY from Project Settings > API > service_role
# (the SECRET key — keep it out of the website's own variables, it is only
# ever used here, once, on your own computer).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional — create several team logins (not admins) in one go. Comma-separated,
# each as email:password:Full Name (the name is optional). Needs the same
# SUPABASE_SERVICE_ROLE_KEY above to work. Example:
# TEAM_MEMBERS=shweta@globriddge.com:Sh1eta$Pass:Shweta Mishra,suyog@globriddge.com:Suy0g$Pass:Suyog Gaikwad
TEAM_MEMBERS=
